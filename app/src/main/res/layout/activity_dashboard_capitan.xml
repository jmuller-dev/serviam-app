                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/montserrat"
                                                android:text="98"
                                                android:textColor="#33C7FF"
                                                android:textSize="18sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <!-- SUBPANEL: MENORES -->
