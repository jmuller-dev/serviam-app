<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_halcones"
    tools:context=".DashboardCapitanActivity">

    <!-- CABECERA (TOP HEADER) -->
    <TextView
        android:id="@+id/textWelcomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/montserrat"
        android:text="BIENVENIDO"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textCapitanName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/montserrat"
        android:text="Capitán Jeremias"
        android:textColor="@color/blanco"
        android:textSize="26sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnMenuAdmin"
        app:layout_constraintTop_toBottomOf="@id/textWelcomeLabel" />

    <FrameLayout
        android:id="@+id/btnResetSession"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_back_button"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/imageProfileButton"
        app:layout_constraintEnd_toStartOf="@id/imageProfileButton"
        app:layout_constraintTop_toTopOf="@id/imageProfileButton">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="@color/blanco" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnMenuAdmin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_back_button"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/imageProfileButton"
        app:layout_constraintEnd_toStartOf="@id/imageProfileButton"
        app:layout_constraintTop_toTopOf="@id/imageProfileButton">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_more"
            app:tint="@color/blanco" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imageProfileButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_user_login"
        app:layout_constraintBottom_toBottomOf="@id/textCapitanName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textWelcomeLabel" />

    <!-- HOJA CONTENEDORA (CONTENT SHEET) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_dashboard_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCapitanName">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- TARJETA: TESORO ESPIRITUAL -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTesoro"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/color_halcones_oscuro"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <!-- Contenedor del ícono de estrella -->
                        <FrameLayout
                            android:id="@+id/starIconContainer"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_icon_container_dark"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_star" />
                        </FrameLayout>

                        <!-- Textos centrales -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/imageArrow"
                            app:layout_constraintStart_toEndOf="@id/starIconContainer"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:text="@string/tesoro_espiritual"
                                android:textColor="@color/blanco"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textTesoroMes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat"
                                android:text="Mayo 2026"
                                android:textColor="#A0FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Flecha de navegación -->
                        <ImageView
                            android:id="@+id/imageArrow"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <!-- TARJETA: CUMPLEAÑOS DEL DÍA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCumpleanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/cardTesoro">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconCumple"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🎂"
                                android:textSize="20sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/containerIconCumple"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Cumpleaños de Hoy"
                                android:textColor="#111111"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/textCumpleanosInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Cargando cumpleaños..."
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA: SANTO DEL DÍA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSantoral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/cardCumpleanos">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconSanto"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✝️"
                                android:textSize="20sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/containerIconSanto"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/textSantoTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="¡Día de Santo!"
                                android:textColor="#111111"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/textSantoNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="San Juan Bosco"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA: CHICOS -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardChicos"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardMaterial"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardSantoral">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconChicos"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/imageIconChicos"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_chicos_halcones" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textTitleChicos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/chicos"
                            android:textColor="@color/color_halcones"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/containerIconChicos" />

                        <TextView
                            android:id="@+id/textSubTitleChicos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/montserrat"
                            android:text="@string/por_brigada"
                            android:textColor="#444444"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textTitleChicos" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA: MATERIAL -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMaterial"
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardChicos"
                    app:layout_constraintTop_toBottomOf="@id/cardSantoral">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconMaterial"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/imageIconMaterial"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_book_halcones" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/textTitleMaterial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/montserrat"
                            android:text="Material"
                            android:textColor="@color/color_halcones"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/containerIconMaterial" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA: CALENDARIO -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/cardChicos">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconCal"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/imageIconCalendario"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calendar" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/imageArrowCal"
                            app:layout_constraintStart_toEndOf="@id/containerIconCal"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/textTitleCalendario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat"
                                android:text="Calendario"
                                android:textColor="@color/color_halcones"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textSubTitleCalendario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/montserrat"
                                android:text="Eventos, cumpleaños y festividades"
                                android:textColor="#444444"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageArrowCal"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- CONTENEDOR DE CAMPAMENTO (DINÁMICO) -->
                <FrameLayout
                    android:id="@+id/layoutCampamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cardCalendario">

                    <!-- CASO 1: SIN CAMPAMENTO ACTIVO (DASHED CARD) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCrearCampamento"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dashed_card"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <FrameLayout
                                android:id="@+id/containerIconCrearCamp"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_container_dark"
                                android:backgroundTint="#26FFFFFF"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_campamento"
                                    app:tint="@color/blanco" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/imageIconAddCamp"
                                app:layout_constraintStart_toEndOf="@id/containerIconCrearCamp"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/textTitleCrearCamp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat"
                                    android:text="Crear campamento"
                                    android:textColor="@color/blanco"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textSubTitleCrearCamp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/montserrat"
                                    android:text="No hay ninguno activo por ahora"
                                    android:textColor="#B2FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/imageIconAddCamp"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_add"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/blanco" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CASO 2: CON CAMPAMENTO ACTIVO (GREEN CARD WITH LIVE SCORES) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCampamentoActivoInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="18dp"
                        app:cardBackgroundColor="#1A823B"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <FrameLayout
                                android:id="@+id/containerIconCampActive"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_container_dark"
                                android:backgroundTint="#26FFFFFF"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_campamento"
                                    app:tint="@color/blanco" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="@id/containerIconCampActive"
                                app:layout_constraintEnd_toStartOf="@id/badgeVivo"
                                app:layout_constraintStart_toEndOf="@id/containerIconCampActive"
                                app:layout_constraintTop_toTopOf="@id/containerIconCampActive">

                                <TextView
                                    android:id="@+id/textCampActiveName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:fontFamily="@font/montserrat"
                                    android:text="Campamento Invierno 2026"
                                    android:textColor="@color/blanco"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
