<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_halcones"
    tools:context=".MaterialesActivity">

    <!-- CABECERA (TOP HEADER) -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_back_arrow" />
    </FrameLayout>

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/montserrat"
        android:text="MATERIAL DE FORMACIÓN"
        android:textColor="@color/blanco"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- HOJA CONTENEDORA (CONTENT SHEET) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_dashboard_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <!-- Barra de Búsqueda -->
        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_search_bar_halcones"
            android:hint="Buscar materiales..."
            android:textColorHint="#C0FFFFFF"
            android:textColor="@color/blanco"
            android:fontFamily="@font/montserrat"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:maxLines="1"
            android:inputType="text"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Filtros de Categoría -->
        <HorizontalScrollView
            android:id="@+id/scrollFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/editSearch">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAll"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Todos"
                    android:textColor="@color/blanco"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/color_halcones"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterMistica"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Mística"
                    android:textColor="@color/gris"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F2F2F2"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterCharlas"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Cursos"
                    android:textColor="@color/gris"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F2F2F2"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterFormacion"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Formación"
                    android:textColor="@color/gris"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F2F2F2"
                    app:cornerRadius="19dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterOraciones"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Oraciones"
                    android:textColor="@color/gris"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F2F2F2"
                    app:cornerRadius="19dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMateriales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFilters" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="No hay materiales cargados"
            android:textColor="@color/gris"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollFilters" />

        <!-- FAB: Agregar Material -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddMaterial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_user_add"
            app:backgroundTint="@color/color_halcones"
            app:tint="@color/blanco"
            app:elevation="4dp"
            app:fabSize="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
