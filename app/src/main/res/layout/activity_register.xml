<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_halcones">

    <ImageView
        android:id= "@+id/logoHalcones"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src= "@drawable/ic_user_add"/>

    <TextView
        android:id="@+id/textBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crear_cuenta"
        android:textColor="@color/blanco"
        android:textSize="28sp"
        android:fontFamily="@font/montserrat"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logoHalcones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/textSeleccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/a_halcones"
        android:textColor="#929292"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textBienvenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-4dp"/>

    <!-- CAMPO: DNI -->
    <TextView
        android:id="@+id/labelDni"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="16dp"
        android:text="DNI"
        android:textColor="@color/blanco"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSeleccion"/>

    <LinearLayout
        android:id="@+id/inputDni"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelDni">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/icono_dni" />

        <EditText
            android:id="@+id/editDni"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hint_dni"
            android:inputType="number"
            android:textColor="@color/blanco"
            android:textColorHint="@color/gris"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- CAMPO: CONTRASEÑA -->
    <TextView
        android:id="@+id/labelPass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="12dp"
        android:text="Contraseña"
        android:textColor="@color/blanco"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputDni"/>

    <LinearLayout
        android:id="@+id/inputPass"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelPass">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/icono_candado" />

        <EditText
            android:id="@+id/editPass"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:textColor="@color/blanco"
            android:textColorHint="@color/gris"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnTogglePass"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/icono_ojo"/>
    </LinearLayout>

    <!-- CAMPO: REPETIR CONTRASEÑA -->
    <TextView
        android:id="@+id/labelPassRepeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="12dp"
        android:text="@string/repetir_contrasena"
        android:textColor="@color/blanco"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputPass"/>

    <LinearLayout
        android:id="@+id/inputPassRepeat"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelPassRepeat">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/icono_candado" />

        <EditText
            android:id="@+id/editPassRepeat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:textColor="@color/blanco"
            android:textColorHint="@color/gris"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnTogglePassRepeat"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/icono_ojo"/>
    </LinearLayout>

    <!-- BOTÓN CREAR CUENTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearCuenta"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="22dp"
        android:backgroundTint="@color/blanco"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/crear_cuenta"
        android:textColor="@color/color_halcones"
        android:fontFamily="@font/montserrat"
        android:textStyle="bold"
        android:textSize="15sp"
        app:cornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputPassRepeat" />

    <!-- AVISO DE WHITELIST -->
    <TextView
        android:id="@+id/textNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32dp"
        android:text="@string/dni_no_registrado"
        android:textColor="#C0FFFFFF"
        android:textSize="13sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCrearCuenta" />


    <!-- BARRA INFERIOR -->
    <LinearLayout
        android:id = "@+id/cajaAsociacion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/color_halcones_oscuro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flecha_izquierda"
            android:textColor="@color/blanco"
            android:textSize="24sp"
            android:layout_marginTop="-7dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/textVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volver_seleccion"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:layout_marginTop="-5dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>