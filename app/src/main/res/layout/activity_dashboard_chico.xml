<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_halcones"
    tools:context=".DashboardChicoActivity">

    <!-- BANNER PREVIEW ADMIN (SOLO CUANDO SE ACCEDE COMO VISTA CHICO DESDE ADMIN) -->
    <LinearLayout
        android:id="@+id/bannerAdminPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnToAdmin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/blanco"
            android:fontFamily="@font/montserrat"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Volver a Admin"
            android:textColor="#D32F2F"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:fontFamily="@font/montserrat"
            android:text="👁️ MODO VISTA DE CHICO"
            android:textColor="@color/blanco"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CABECERA (TOP HEADER) -->
    <TextView
        android:id="@+id/textWelcomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/montserrat"
        android:text="BIENVENIDO"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerAdminPreview" />

    <TextView
        android:id="@+id/textChicoName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/montserrat"
        android:text="Chico Jeremias"
        android:textColor="@color/blanco"
        android:textSize="26sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnResetSession"
        app:layout_constraintTop_toBottomOf="@id/textWelcomeLabel" />

    <TextView
        android:id="@+id/textBrigadaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/montserrat"
        android:text="Brigada Conquistadores"
        android:textColor="#F5FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textChicoName" />

    <FrameLayout
        android:id="@+id/btnResetSession"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_back_button"
        app:layout_constraintBottom_toBottomOf="@id/imageProfileButton"
        app:layout_constraintEnd_toStartOf="@id/imageProfileButton"
        app:layout_constraintTop_toTopOf="@id/imageProfileButton">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="@color/blanco" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imageProfileButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/ic_user_login"
        app:layout_constraintBottom_toBottomOf="@id/textBrigadaLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textWelcomeLabel" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dashboard_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textBrigadaLabel">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="80dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- TARJETA: CUMPLEAÑOS DEL DÍA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCumpleanos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconCumple"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🎂"
                                android:textSize="20sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/containerIconCumple"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Cumpleaños de Hoy"
                                android:textColor="#111111"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/textCumpleanosInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Cargando cumpleaños..."
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- TARJETA: SANTO DEL DÍA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSantoral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/cardCumpleanos">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <FrameLayout
                            android:id="@+id/containerIconSanto"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container_light"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="✝️"
                                android:textSize="20sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/containerIconSanto"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/textSantoTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="¡Día de Santo!"
                                android:textColor="#111111"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/textSantoNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="San Juan Bosco"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECCIÓN: MATERIALES HABILITADOS -->
                <TextView
                    android:id="@+id/labelMateriales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Materiales de Formación"
                    android:textColor="@color/color_halcones"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cardSantoral"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMaterialesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/labelMateriales">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat"
                        android:text="No hay materiales habilitados en este momento"
                        android:textColor="#444444"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

                <!-- SECCIÓN: PRÓXIMAS ACTIVIDADES -->
                <TextView
                    android:id="@+id/labelActividades"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Próximas Actividades"
                    android:textColor="@color/color_halcones"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cardMaterialesEmpty"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toBottomOf="@id/labelActividades">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="Sábado 16:00 hs — Reunión General"
                            android:textColor="@color/negro"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/montserrat"
                            android:text="Lugar: Predio de la Parroquia. Traer uniforme completo y cuaderno de notas."
                            android:textColor="#444444"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CONTENEDOR DE CAMPAMENTO (DINÁMICO) -->
                <FrameLayout
                    android:id="@+id/layoutCampamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintTop_toBottomOf="@id/cardActividades">

                    <!-- CASO 1: SIN CAMPAMENTO ACTIVO (DASHED CARD) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCrearCampamento"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        android:clickable="false"
                        android:focusable="false">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dashed_card"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <FrameLayout
                                android:id="@+id/containerIconCrearCamp"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_container_dark"
                                android:backgroundTint="#26FFFFFF"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_campamento"
                                    app:tint="@color/blanco" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/containerIconCrearCamp"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:id="@+id/textTitleCrearCamp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/montserrat"
                                    android:text="Sin campamento activo"
                                    android:textColor="@color/blanco"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textSubTitleCrearCamp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/montserrat"
                                    android:text="No hay ninguno activo por ahora"
                                    android:textColor="#B2FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/imageIconAddCamp"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_add"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/blanco" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CASO 2: CON CAMPAMENTO ACTIVO (GREEN CARD WITH LIVE SCORES) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCampamentoActivoInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="18dp"
                        app:cardBackgroundColor="#1A823B"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <FrameLayout
                                android:id="@+id/containerIconCampActive"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_container_dark"
                                android:backgroundTint="#26FFFFFF"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_campamento"
                                    app:tint="@color/blanco" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="8dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="@id/containerIconCampActive"
                                app:layout_constraintEnd_toStartOf="@id/badgeVivo"
                                app:layout_constraintStart_toEndOf="@id/containerIconCampActive"
                                app:layout_constraintTop_toTopOf="@id/containerIconCampActive">

                                <TextView
                                    android:id="@+id/textCampActiveName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:fontFamily="@font/montserrat"
                                    android:text="Campamento Invierno 2026"
                                    android:textColor="@color/blanco"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textCampActiveDay"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/montserrat"
                                    android:text="Día 2 · Tocá para ver puntos"
                                    android:textColor="#B2FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- BADGE: VIVO -->
                            <TextView
                                android:id="@+id/badgeVivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_button_outline"
                                android:backgroundTint="#26FFFFFF"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="VIVO"
                                android:textColor="@color/blanco"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/montserrat"
                                app:layout_constraintBottom_toBottomOf="@id/containerIconCampActive"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/containerIconCampActive" />

                            <!-- PANEL DE DIVISIONES (MAYORES Y MENORES) -->
                            <LinearLayout
                                android:id="@+id/layoutScoresPanel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layout_constraintTop_toBottomOf="@id/containerIconCampActive">

                                <!-- SUBPANEL: MAYORES -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    app:cardCornerRadius="12dp"
                                    app:cardBackgroundColor="#26000000"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="10dp"
                                        android:gravity="center">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/montserrat"
                                            android:text="MAYORES"
                                            android:textColor="#B2FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/textTeamsMayor"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
                                            android:fontFamily="@font/montserrat"
                                            android:text="Cóndor vs Tero"
                                            android:textColor="@color/blanco"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:orientation="horizontal"
                                            android:layout_marginTop="4dp"
                                            android:gravity="center">

                                            <TextView
                                                android:id="@+id/textScoreMayor1"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/montserrat"
                                                android:text="124"
                                                android:textColor="#33C7FF"
                                                android:textSize="18sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="6dp"
                                                android:layout_marginEnd="6dp"
                                                android:fontFamily="@font/montserrat"
                                                android:text="vs"
                                                android:textColor="#B2FFFFFF"
                                                android:textSize="12sp"
                                                android:textStyle="bold" />

                                            <TextView
                                                android:id="@+id/textScoreMayor2"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="@font/montserrat"
                                                android:text="98"
                                                android:textColor="#33C7FF"
                                                android:textSize="18sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <!-- SUBPANEL: MENORES -->
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    app:cardCornerRadius="12dp"
                                    app:cardBackgroundColor="#26000000"
                                    app:cardElevation="0dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="10dp"
                                        android:gravity="center">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/montserrat"
                                            android:text="MENORES"
                                            android:textColor="#B2FFFFFF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/textTeamsMenor"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:ellipsize="end"
                                            android:maxLines="1"
