<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- DNI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="DNI (Opcional)"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editDni"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingrese DNI (Opcional)"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

        <!-- Nombre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Nombre Completo"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingrese Nombre"
            android:inputType="textPersonName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

        <!-- Brigada -->
        <TextView
            android:id="@+id/labelBrigada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Brigada"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinnerBrigada"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:padding="12dp" />

        <!-- Edad (Calculada automáticamente según fecha de nacimiento) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Edad (Calculada automáticamente)"
            android:textColor="@color/negro"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/editEdad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Calculada por fecha de nacimiento"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            android:textSize="14sp" />

        <!-- Fecha Nacimiento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Fecha de Nacimiento"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editFechaNac"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="DD/MM/AAAA"
            android:inputType="datetime"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

        <!-- Teléfono Chico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Teléfono Chico"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editTelChico"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingrese Teléfono del Chico"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

        <!-- Teléfono Padres -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Teléfono Padres / Contacto"
            android:textColor="@color/negro"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editTelPadres"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_field"
            android:hint="Ingrese Teléfono del Tutor"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
