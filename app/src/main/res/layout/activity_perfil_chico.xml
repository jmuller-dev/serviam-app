<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_halcones"
    tools:context=".PerfilChicoActivity">

    <!-- CABECERA (TOP HEADER) -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_back_arrow" />
    </FrameLayout>

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/montserrat"
        android:text="FICHA DEL INTEGRANTE"
        android:textColor="@color/blanco"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Edit Button (Top Right) -->
    <FrameLayout
        android:id="@+id/btnEdit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_back_button"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_edit"
            app:tint="@color/blanco" />
    </FrameLayout>

    <!-- HOJA CONTENEDORA (CONTENT SHEET) -->
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_dashboard_sheet"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- FOTO / INICIAL CON CONTENEDOR DE COLOR -->
            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_icon_container_light"
                android:backgroundTint="@color/color_halcones_mas_claro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserrat"
                    android:text="J"
                    android:textColor="@color/color_halcones"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Datos Generales a la derecha -->
            <TextView
                android:id="@+id/textChicoNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/montserrat"
                android:text="Jeremias Muller"
                android:textColor="@color/negro"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatarContainer"
                app:layout_constraintTop_toTopOf="@id/avatarContainer" />

            <TextView
                android:id="@+id/textChicoBrigada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_icon_container_light"
                android:backgroundTint="@color/brigada_conquistadores"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/blanco"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat"
                app:layout_constraintStart_toEndOf="@id/avatarContainer"
                app:layout_constraintTop_toBottomOf="@id/textChicoNombre"
                tools:text="CONQUISTADORES" />

            <TextView
                android:id="@+id/textChicoDni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/gris"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/textChicoBrigada"
                app:layout_constraintStart_toEndOf="@id/textChicoBrigada"
                app:layout_constraintTop_toTopOf="@id/textChicoBrigada"
                tools:text="DNI: 45.123.456" />

            <!-- SECCIÓN: ASISTENCIA -->
            <TextView
                android:id="@+id/labelAsistencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/montserrat"
                android:text="Control de Asistencia"
                android:textColor="@color/color_halcones"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/labelAsistencia">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="Porcentaje de Asistencia"
                            android:textColor="@color/negro"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textPorcentajeAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:text="100%"
                            android:textColor="@color/verde_punto"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserrat"
                        android:text="Historial de Sábados (Últimos 4)"
                        android:textColor="@color/gris"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Fila de celdas de asistencia -->
                    <LinearLayout
                        android:id="@+id/layoutAsistenciaCeldas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center">
                        <!-- Las celdas se agregarán dinámicamente o por placeholders en el XML -->
                    </LinearLayout>

                    <!-- Botón para registrar asistencia del sábado actual -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleAsistenciaHoy"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="REGISTRAR ASISTENCIA HOY"
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/color_halcones" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECCIÓN: DETALLES DE CONTACTO -->
            <TextView
                android:id="@+id/labelContacto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat"
                android:text="Información de Contacto"
                android:textColor="@color/color_halcones"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAsistencia" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/labelContacto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Edad -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="Edad / Nacimiento"
                        android:textColor="@color/gris"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textChicoEdadNac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/negro"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="14 años (15/04/2012)" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EAEAEA"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Teléfono Chico -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="Teléfono Personal"
                        android:textColor="@color/gris"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textChicoTel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/negro"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="+54 9 11 1234-5678" />

                        <ImageView
                            android:id="@+id/btnCallChico"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="@color/color_halcones"
                            android:padding="4dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EAEAEA"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Teléfono Padres -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:text="Contacto Padres / Tutores"
                        android:textColor="@color/gris"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textChicoPadresTel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/negro"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="+54 9 11 8765-4321" />

                        <ImageView
                            android:id="@+id/btnCallPadres"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="@color/color_halcones"
                            android:padding="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ACCIONES DE ADMINISTRACIÓN (CAPITÁN) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBajaChico"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="DAR DE BAJA INTEGRANTE"
                android:textColor="@color/rojo_punto"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/rojo_punto"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardContacto" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
